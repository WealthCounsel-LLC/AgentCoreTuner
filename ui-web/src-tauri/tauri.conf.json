{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWS AgentCore",
  "version": "0.1.0",
  "identifier": "com.agentcore.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run check-deps && npm run dev",
    "beforeBuildCommand": "npm run check-deps && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AWS AgentCore",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "fonts/*"
    ]
  }
}
